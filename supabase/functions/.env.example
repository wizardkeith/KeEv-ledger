# Set with `supabase secrets set`; never commit actual values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BILLING_ENVIRONMENT=sandbox
BILLING_PREMIUM_PRODUCT_IDS=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ROOT_CERTIFICATES_BASE64=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_APPROVED_BASE_PLANS_JSON={}
BILLING_PUBSUB_AUDIENCE=
BILLING_PUBSUB_PUSH_SERVICE_ACCOUNT=
BILLING_RECONCILE_SECRET=
# Separate Sign in with Apple REST key; server-only. Comma-separated bundle/Services IDs.
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
APPLE_SIGNIN_ALLOWED_CLIENT_IDS=
# JSON mapping of Services ID to its registered HTTPS redirect URI; native bundle ID omitted.
APPLE_SIGNIN_REDIRECT_URIS_JSON={}
