      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookkeeping_transactions\" (\"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES local_profiles (id), \"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"project_id\" TEXT NULL REFERENCES projects (id), \"kind\" TEXT NOT NULL, \"amount_minor_units\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"business_date\" TEXT NOT NULL, \"note\" TEXT NULL, \"created_at_utc\" INTEGER NOT NULL, \"updated_at_utc\" INTEGER NOT NULL, \"deleted_at_utc\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (length(id) = 36), CHECK (kind IN ('income','expense')), CHECK (amount_minor_units > 0), CHECK (length(business_date) = 10), CHECK (created_at_utc <= updated_at_utc), CHECK (deleted_at_utc IS NULL OR deleted_at_utc >= created_at_utc));"
