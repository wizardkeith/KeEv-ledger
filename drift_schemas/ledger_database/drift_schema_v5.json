        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES local_profiles (id), \"name\" TEXT NOT NULL, \"amount_minor_units\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"month\" TEXT NOT NULL, \"category_id\" TEXT NULL REFERENCES categories (id), \"warning_threshold_percent\" INTEGER NOT NULL DEFAULT 80, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at_utc\" INTEGER NOT NULL, \"updated_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(id) = 36), CHECK (length(trim(name)) BETWEEN 1 AND 120), CHECK (amount_minor_units >= 0), CHECK (currency_code IN ('HKD','USD','EUR','GBP','JPY','THB','CNY')), CHECK (length(month) = 7 AND substr(month, 5, 1) = '-'), CHECK (warning_threshold_percent BETWEEN 1 AND 100), CHECK (created_at_utc <= updated_at_utc));"
        }
      ]
    },
