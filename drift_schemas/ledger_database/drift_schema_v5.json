    {
      "name": "local_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_profiles\" (\"slot\" INTEGER NOT NULL, \"id\" TEXT NOT NULL UNIQUE, \"base_currency_code\" TEXT NOT NULL, \"created_at_utc\" INTEGER NOT NULL, \"updated_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"slot\"), CHECK (slot = 1), CHECK (length(id) = 36), CHECK (base_currency_code IN ('HKD','USD','EUR','GBP','JPY','THB','CNY')), CHECK (created_at_utc <= updated_at_utc));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES local_profiles (id), \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"currency_code\" TEXT NOT NULL, \"opening_minor_units\" INTEGER NOT NULL, \"opening_date\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at_utc\" INTEGER NOT NULL, \"updated_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(id) = 36), CHECK (length(trim(name)) BETWEEN 1 AND 120), CHECK (kind IN ('cash','bank','creditCard','eWallet','other')), CHECK (currency_code IN ('HKD','USD','EUR','GBP','JPY','THB','CNY')), CHECK (opening_minor_units >= -9223372036854775807), CHECK (length(opening_date) = 10), CHECK (created_at_utc <= updated_at_utc));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES local_profiles (id), \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at_utc\" INTEGER NOT NULL, \"updated_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(id) = 36), CHECK (length(trim(name)) BETWEEN 1 AND 120), CHECK (kind IN ('income','expense')), CHECK (created_at_utc <= updated_at_utc));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES local_profiles (id), \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at_utc\" INTEGER NOT NULL, \"updated_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(id) = 36), CHECK (length(trim(name)) BETWEEN 1 AND 120), CHECK (description IS NULL OR length(description) <= 500), CHECK (created_at_utc <= updated_at_utc));"
        }
      ]
    },
